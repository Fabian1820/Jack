      deny: '\n\nDe acuerdo, no compilo. Actualizo solo el texto del README y dejo los ejemplos sin comprobar.\n\n- Añadí la sección **Modo Light**\n- Te aviso de que los ejemplos están sin verificar',
      tools: [],
    };
  }
  let sessions = [
    { id: 's1', title: 'Arreglar el login', path: '~/dev/checkout-web', when: 'ayer' },
    { id: 's2', title: 'Notas de la versión', path: '~/projects/Jack', when: 'hace 3 días' },
  ];

  let cur = chats[0];
  let maxConc = 1; // «Agentes simultáneos en Light»: 1 por defecto
  const queue: Chat[] = [];
  let timer = 0;
  let minimized = false;
  let onScreen = true;
  let stale = false;
  let usageRead = 'hace 12 min';
  let usageBusy = false;
  let serversBusy = false;
  let bannerChat: Chat | null = null;
  let bannerTimer = 0;
  let created = 0;

  const active = (c: Chat) => c.status !== 'idle';
  const running = () => chats.filter((c) => c.status === 'running').length;
  const uiHidden = () => minimized || !onScreen || document.hidden;
  const flag = (row: string, on: boolean) => rows.forEach((el) => el.dataset.row === row && el.classList.toggle('lit', on));
  let pollTimer = 0;
  function flashPolling() {
    flag('polling', true);
    clearTimeout(pollTimer);
    pollTimer = window.setTimeout(() => flag('polling', false), 2600);
  }

  // ── Pintado ──
  let approvalKey = '';
  let waitKey = '';
  let filesKey = '';
  function render() {
    if (uiHidden()) {
      stale = true;
      return;
    }
    const c = cur;
    const name = PROV[c.provider].name;
    titleEl.textContent = c.title;
    folderEl.textContent = base(c.path);
    folderEl.title = c.path;
    statusEl.textContent = { running: 'Trabajando…', queued: 'En cola', waiting: 'Necesita tu respuesta', idle: 'Listo' }[c.status];

    const aKey = c.approval ? c.id + c.approval.command : '';
    if (aKey !== approvalKey) {
      approvalKey = aKey;
      approvalEl.hidden = !c.approval;
      approvalEl.innerHTML = c.approval
        ? `<div class="lw-card"><div class="hd">${use('i-hand')}${name} necesita tu permiso</div>` +
          `<div class="tt">${esc(c.approval.title)}</div><div class="why">${esc(c.approval.reason)}</div>` +
          `<pre>$ ${esc(c.approval.command)}</pre><div class="acts"><small>O escribe en el chat qué debe hacer en su lugar</small>` +
          `<button class="lw-b" type="button" data-ap="deny" title="Rechazar (Esc)">Rechazar</button>` +
          `<button class="lw-b pri" type="button" data-ap="allow" title="Permitir una vez (⌘↩)">Permitir</button></div></div>`
        : '';
    }
    const wKey = c.id + JSON.stringify(c.waiting);
    if (wKey !== waitKey) {
      waitKey = wKey;
      waitEl.hidden = !c.waiting.length;
      waitEl.innerHTML = c.waiting.length
        ? `<div class="hd">${use('i-clock')}<b>En espera</b><span>· se enviará cuando ${name} termine</span>` +
          `<button class="now" type="button" data-w="now" title="Detiene el paso en curso para que ${name} lea ya los mensajes en espera (⌘↩)">` +
          `Interrumpir y enviar <em>⌘↩</em></button></div>` +
          c.waiting
            .map(
              (m, i) =>
                `<div class="q"><i>›</i><span>${esc(m.text || 'Archivos adjuntos')}</span>` +
                `<button type="button" data-w="edit" data-i="${i}" title="Editar: lo devuelve al cuadro de mensaje" aria-label="Editar mensaje en espera">${use('i-pencil')}</button>` +
                `<button type="button" data-w="rm" data-i="${i}" title="Quitar de la espera" aria-label="Quitar mensaje en espera">${use('i-x')}</button></div>`,
            )
            .join('')
        : '';
    }
    const fKey = c.id + c.files.join('|');
    if (fKey !== filesKey) {
      filesKey = fKey;
      filesEl.hidden = !c.files.length;
      filesEl.innerHTML = c.files
        .map((f, i) => `<button class="lw-b sm" type="button" data-f="${i}" title="${esc(f)}">${esc(base(f))} ×</button>`)
        .join('');
    }
    renderComposer();

    const st = c.run ?? c.stats;
    meterText.innerHTML =
      st && st.normal
        ? `Esta respuesta: <b>${st.light}</b> ${st.light === 1 ? 'repintado' : 'repintados'} en Light · <b class="n">${st.normal}</b> en Normal`
        : 'Envía un mensaje y mira cómo llega el texto: en bloques, una vez por segundo.';
    flag('stream', chats.some((x) => x.status === 'running' && x.run !== null && x.run.think <= 0));
    flag('parallel', chats.some((x) => x.status === 'queued'));
  }
  function renderComposer() {
    sendBtn.textContent = active(cur) ? 'En cola' : 'Enviar';
    sendBtn.disabled = !input.value.trim() && !cur.files.length;
    stopBtn.hidden = !active(cur);
  }
  function renderLog(stick = true) {
    if (uiHidden()) {
      stale = true;
      return;
    }
    const near = log.scrollHeight - log.scrollTop - log.clientHeight < 48;
    log.innerHTML = cur.msgs
      .map((m) => {
        const head = m.role === 'user' ? 'Tú' : m.role === 'jack' ? 'Jack' : m.role === 'error' ? 'Error' : 'Agente';
        // Los mensajes del usuario se quedan literales, igual que en la app.
        const body = m.role === 'assistant' ? md(m.text) : `<p>${esc(m.text).replace(/\n/g, '<br>')}</p>`;
        const files = (m.files ?? []).map((f) => `<p>Adjunto: ${esc(f)}</p>`).join('');
        return `<div class="lw-msg ${m.role}"><h6>${head}</h6>${body}${files}</div>`;
      })
      .join('');
    if (stick || near) log.scrollTop = log.scrollHeight;
  }
  function refresh() {
    if (uiHidden() || !stale) return;
    stale = false;
    render();
    renderLog();
  }

  // ── Motor: una respuesta llega palabra a palabra, pero Light la pinta por segundos ──
  function makeRun(c: Chat, text: string): Run {
    const q = text.trim().replace(/\s+/g, ' ');
    const about = q ? `«${q.length > 60 ? q.slice(0, 57) + '…' : q}»` : 'los archivos adjuntos';
    const folder = base(c.path);
    const run: Run = {
      tokens: [],
      pos: 0,
      acc: 0,
      think: 600,
      since: 0,
      dirty: false,
      light: 0,
      normal: 0,
      msg: null,
      ask: null,
      asked: false,
      allow: '',
      deny: '',
      tools: [{ text: 'Read', status: 'completed', detail: PROJECT_FILES[folder]?.[0] ?? 'README.md' }],
    };
    const kind = c.n % 3;
    if (kind === 1) {
      run.tokens = tok(`Para responder a ${about} necesito lanzar los tests del proyecto.`);
      run.ask = { title: 'Ejecutar un comando', reason: 'Lanza la batería de tests del proyecto', command: 'npm test' };
      run.allow =
        '\n\nTests ejecutados: **14 en verde**, 0 fallos.\n\n- La parte por la que preguntas está cubierta\n- No hizo falta tocar nada más\n\nPuedes seguir desde aquí.';
      run.deny =
        '\n\nDe acuerdo, no ejecuto el comando. Si quieres lanzarlo tú:\n\n```\nnpm test\n```\n\nMientras tanto sigo solo con lectura.';
    } else if (kind === 0) {
      run.tokens = tok(
        `Sobre ${about}: lo he revisado en \`${folder}\`.\n\n- Leí los archivos implicados y el cambio es acotado\n- No rompe la compilación ni los tests actuales\n- Lo pendiente queda anotado al final de esta conversación\n\nSi quieres, lo aplico ahora mismo.`,
      );
    } else {
      run.tokens = tok(
        `Hecho. Resumen de ${about}:\n\n- Cambié lo mínimo necesario en \`${folder}\`\n- Dejé el resto como estaba\n- Añadí una nota con lo que conviene revisar después\n\nNo queda nada pendiente por mi parte.`,
      );
      run.tools.push({ text: 'Edit', status: 'completed', detail: PROJECT_FILES[folder]?.[1] ?? 'README.md' });
    }
    c.n += 1;
    return run;
  }
  function commit(c: Chat, r: Run) {
    if (!r.msg) {
      r.msg = { role: 'assistant', text: '' };
      c.msgs.push(r.msg);
    }
    r.msg.text = r.tokens.slice(0, r.pos).join('').trimEnd();
    r.dirty = false;
    if (!uiHidden()) r.light += 1; // con la interfaz suspendida no se repinta nada
    if (c === cur) renderLog(false);
  }
  function pump() {
    while (queue.length && running() < maxConc) {
      const c = queue.shift()!;
      c.status = 'running';
      if (c.run) c.run.since = performance.now();
    }
    if (!timer && running()) timer = window.setInterval(tick, TICK_MS);
    render();
  }
  function enqueue(c: Chat) {
    c.status = 'queued';
    if (!queue.includes(c)) queue.push(c);
    pump();
  }
  function start(c: Chat, text: string, files: string[]) {
    c.msgs.push({ role: 'user', text, files: files.length ? files : undefined });
    c.run = makeRun(c, text);
    if (c === cur) renderLog();
    enqueue(c);
  }
  function endRun(c: Chat, chain = true) {
    const r = c.run;
    if (r) {
      if (r.dirty) commit(c, r);
      c.stats = { light: r.light, normal: r.normal };
      c.tools.push(...r.tools);
    }
    c.run = null;
    c.approval = null;
    c.status = 'idle';
    const at = queue.indexOf(c);
    if (at >= 0) queue.splice(at, 1);
    const next = chain ? c.waiting.shift() : undefined;
    if (next) start(c, next.text, next.files);
    else pump();
  }
  function notify(c: Chat, prefix: string, detail: string) {
    if (!minimized) return; // la app solo avisa si la ventana no está a la vista
    bannerChat = c;
    $('lw-banner-title').textContent = prefix + c.title;
    $('lw-banner-body').textContent = detail.slice(0, 240);
    banner.hidden = true;
    void banner.offsetWidth;
    banner.hidden = false;
    clearTimeout(bannerTimer);
    bannerTimer = window.setTimeout(() => (banner.hidden = true), 8000);
  }
  function tick() {
    const now = performance.now();
    let changed = false;
    for (const c of chats) {
      const r = c.run;
      if (!r || c.status !== 'running') continue;
      if (r.think > 0) {
        r.think -= TICK_MS;
        if (r.think <= 0) {
          r.since = now;
          changed = true;
        }
        continue;
      }
      r.acc += TICK_MS;
      if (r.acc >= TOKEN_MS && r.pos < r.tokens.length) {
        r.acc -= TOKEN_MS;
        r.pos += 1;
        r.dirty = true;
        r.normal += 1;
      }
      const end = r.pos >= r.tokens.length;
      if (r.dirty && (end || now - r.since >= FLUSH_MS)) {
        commit(c, r);
        r.since = now;
        changed = true;
      }
      if (!end) continue;
      changed = true;
      if (r.ask && !r.asked) {
        r.asked = true;
        c.approval = r.ask;
        c.status = 'waiting';
        notify(c, 'Necesita tu respuesta: ', r.ask.title);
        pump();
      } else {
        if (c !== cur) c.unread = true;
        notify(c, 'Terminó: ', r.msg?.text ?? '');
        endRun(c);
      }
    }
    if (!running()) {
      clearInterval(timer);
      timer = 0;
    }
    if (changed) render();
  }
  function answer(c: Chat, choice: 'allow' | 'deny') {
    const r = c.run;
    c.approval = null;
    if (!r) {
      c.status = 'idle';
      render();
      return;
    }
    r.tokens.push(...tok(choice === 'allow' ? r.allow : r.deny));
    if (choice === 'allow' && r.ask) r.tools.push({ text: 'Bash', status: 'completed', detail: '$ ' + r.ask.command });
    r.ask = null;
    enqueue(c);
  }
  function sendWaitingNow(c: Chat) {
    const next = c.waiting.shift();
    if (!next) return;
    endRun(c, false);
    start(c, next.text, next.files);
  }
  function send(interrupting = false) {
    const c = cur;
    const text = input.value.trim();
    if (!text && !c.files.length) {
      if (interrupting && c.waiting.length) sendWaitingNow(c);
      return;
    }
    const msg: Queued = { text, files: c.files.slice() };
    input.value = '';
    c.draft = '';
    c.files = [];
    if (c.approval) {
      // Escribir con un permiso pendiente lo rechaza y le dice qué hacer en su lugar.
      endRun(c, false);
      start(c, msg.text, msg.files);
    } else if (active(c)) {
      c.waiting.push(msg);
      if (interrupting) sendWaitingNow(c);
      else render();
    } else start(c, msg.text, msg.files);
  }
  function select(c: Chat) {
    cur = c;
    c.unread = false;
    input.value = c.draft;
    closeSheet();
    render();
    renderLog();
  }

  // ── Menús ──
  function closeMenus() {
    for (const [btn, menu] of [
      [chatsBtn, chatsMenu],
