<script>
// ── Interruptor "Prueba Light en esta web": pausa las animaciones de la página ──
const webToggle = document.getElementById('light-toggle');
const webState = document.getElementById('light-state');
webToggle?.addEventListener('click', () => {
  const on = document.documentElement.dataset.light !== 'on';
  document.documentElement.dataset.light = on ? 'on' : 'off';
  webToggle.setAttribute('aria-pressed', String(on));
  if (webState) webState.textContent = on ? 'Animaciones en pausa: el hero se ha congelado' : 'Las animaciones están activas';
});

// ── Ventana Light ──
const PROV = {
  codex: { name: 'Codex', sym: 'p-codex', tint: '#e8e8f0', models: ['gpt-6-luna'] },
  claude: { name: 'Claude Code', sym: 'p-claude', tint: '#d97757', models: ['Predeterminado', 'Opus 5.5'] },
  opencode: { name: 'OpenCode', sym: 'p-opencode', tint: '#40c8e0', models: ['Predeterminado'] },
  stellar: { name: 'Stellar Code', sym: 'p-stellar', tint: '#5e5ce6', models: ['Predeterminado'] },
};
type Prov = keyof typeof PROV;
type Status = 'idle' | 'running' | 'queued' | 'waiting';
type Msg = { role: 'user' | 'assistant' | 'jack' | 'error'; text: string; files?: string[] };
type Tool = { text: string; status: string; detail: string };
type Approval = { title: string; reason: string; command: string };
type Queued = { text: string; files: string[] };
type Run = {
  tokens: string[];
  pos: number;
  acc: number;
  think: number;
  since: number;
  dirty: boolean;
  light: number; // repintados reales en Light (uno por segundo, y ninguno si está suspendida)
  normal: number; // los que haría Normal agrupando cada 50 ms
  msg: Msg | null;
  ask: Approval | null;
  asked: boolean;
  allow: string;
  deny: string;
  tools: Tool[];
};
type Chat = {
  id: string;
  title: string;
  provider: Prov;
  path: string;
  model: string;
  msgs: Msg[];
  status: Status;
  draft: string;
  files: string[];
  waiting: Queued[];
  approval: Approval | null;
  unread: boolean;
  tools: Tool[];
  n: number;
  run: Run | null;
  stats: { light: number; normal: number } | null;
};

const FLUSH_MS = 1000; // Light agrupa el texto en streaming cada segundo
const TICK_MS = 50; // Normal lo agrupa cada 50 ms
const TOKEN_MS = 90; // ritmo al que el proveedor entrega cada palabra
const JACK_COMMANDS: [string, string, string][] = [
  ['btw', 'pregunta', 'Pregunta al margen sin interrumpir al agente ni entrar en su historial (⌥↩)'],
  ['compact', '8000', 'Reduce el contexto mediante un resumen; conserva el historial'],
  ['autocompact', '30000 8000 | off', 'Compacta antes del siguiente mensaje al superar el umbral'],
  ['contexto', '', 'Muestra contexto y presupuesto'],
  ['fijar', 'texto | listar | quitar número', 'Conserva instrucciones en futuras sesiones'],
  ['resumen', '', 'Resume decisiones, avances y pendientes'],
  ['checkpoint', 'nombre | restaurar nombre', 'Guarda una copia o restaura en otra conversación'],
  ['rama', 'nombre', 'Crea una conversación independiente con el contexto actual'],
  ['traspasar', 'codex | claude | opencode (opcional)', 'Prepara un resumen para otro modelo o proveedor'],
  ['plan', 'tarea', 'Activa Plan y prepara la tarea'],
  ['revisar', 'instrucciones opcionales', 'Revisa los cambios del proyecto'],
  ['presupuesto', '20000 | off', 'Avisa al acercarse al presupuesto de tokens'],
  ['comandos', 'crear nombre texto | eliminar nombre', 'Lista, crea o elimina plantillas personales'],
];
const PROVIDER_COMMANDS: Record<Prov, [string, string][]> = {
  codex: [
    ['compact', 'Resume la conversación para liberar contexto'],
    ['review', 'Revisa los cambios actuales'],
    ['init', 'Crea AGENTS.md con instrucciones del proyecto'],
  ],
  claude: [
    ['compact', 'Resume la conversación para liberar contexto'],
    ['review', 'Revisa un pull request'],
    ['init', 'Crea CLAUDE.md con instrucciones del proyecto'],
  ],
  opencode: [
    ['init', 'Crea o actualiza AGENTS.md'],
    ['compact', 'Compacta la sesión'],
  ],
  stellar: [
    ['init', 'Crea o actualiza AGENTS.md'],
    ['compact', 'Compacta la sesión'],
  ],
};
const PROJECT_FILES: Record<string, string[]> = {
  'checkout-web': ['vite.config.ts', 'package.json', 'src/checkout/Cart.tsx', 'src/checkout/pay.ts', 'README.md'],
  Jack: ['README.md', 'Package.swift', 'Sources/Jack/LightWindowView.swift', 'Sources/JackCore/ChatStore.swift'],
};

const win = document.getElementById('lw');
const desk = document.getElementById('lw-desk');

if (win && desk) {
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const titleEl = $('lw-chat-title');
  const folderEl = $('lw-folder');
  const statusEl = $('lw-status');
  const log = $('lw-log');
  const approvalEl = $('lw-approval');
  const waitEl = $('lw-wait');
  const filesEl = $('lw-files');
  const input = $<HTMLTextAreaElement>('lw-input');
  const sendBtn = $<HTMLButtonElement>('lw-send');
  const stopBtn = $<HTMLButtonElement>('lw-stop');
  const chatsBtn = $('lw-chats-btn');
  const chatsMenu = $('lw-chats-menu');
  const moreBtn = $('lw-more-btn');
  const moreMenu = $('lw-more-menu');
  const veil = $('lw-veil');
  const sheetBody = $('lw-sheet-body');
  const sheetFoot = $('lw-sheet-foot');
  const banner = $('lw-banner');
  const meterText = $('lw-meter-text');
  const modeSwitch = $('lw-switch');
  const rows = [...document.querySelectorAll<HTMLElement>('#lw-compare [data-row]')];

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch] ?? ch);
  const base = (path: string) => path.split('/').filter(Boolean).pop() ?? path;
  const tok = (s: string) => s.match(/\S+\s*/g) ?? [];
  const inline = (s: string) =>
    esc(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');
  // Markdown mínimo: párrafos, listas, código en línea y bloques.
  function md(src: string) {
    const out: string[] = [];
    src.split('```').forEach((part, i) => {
      if (i % 2) {
        out.push(`<pre>${esc(part.replace(/^[a-z]*\n/, '').replace(/\n$/, ''))}</pre>`);
        return;
      }
      for (const block of part.split(/\n{2,}/)) {
        const b = block.trim();
        if (!b) continue;
        const lines = b.split('\n');
        if (lines.every((l) => l.startsWith('- '))) {
          out.push(`<ul>${lines.map((l) => `<li>${inline(l.slice(2))}</li>`).join('')}</ul>`);
        } else out.push(`<p>${inline(b).replace(/\n/g, '<br>')}</p>`);
      }
    });
    return out.join('');
  }
  const use = (id: string, style = '') => `<svg aria-hidden="true"${style ? ` style="${style}"` : ''}><use href="#${id}"></use></svg>`;

  const chat = (c: Partial<Chat> & Pick<Chat, 'id' | 'title' | 'provider' | 'path'>): Chat => ({
    model: PROV[c.provider].models[0],
    msgs: [],
    status: 'idle',
    draft: '',
    files: [],
    waiting: [],
    approval: null,
