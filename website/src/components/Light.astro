  moreBtn.addEventListener('click', () => toggleMenu(moreBtn, moreMenu));
  moreMenu.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-panel]');
    if (!b) return;
    closeMenus();
    if (b.dataset.panel === 'normal') toNormal();
    else openSheet(b.dataset.panel ?? '');
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest?.('.lw-pop')) closeMenus();
  });

  // En la web, «Normal» es la demo de arriba.
  function toNormal() {
    modeSwitch.setAttribute('aria-checked', 'false');
    window.setTimeout(() => document.getElementById('demo')?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 320);
    window.setTimeout(() => modeSwitch.setAttribute('aria-checked', 'true'), 1600);
  }
  modeSwitch.addEventListener('click', toNormal);

  // ── Hojas ──
  let sheet = '';
  let fill: (() => void) | null = null;
  const newAgent = { space: '', provider: 'codex' as Prov, model: 'gpt-6-luna', effort: 'high', msg: '' };
  const CLOSE = '<span class="lw-grow"></span><button class="lw-b" type="button" data-act="close">Cerrar</button>';
  const spaces = () => [...new Set(chats.map((c) => c.path))].sort();
  const query = () => (sheetBody.querySelector<HTMLInputElement>('#lw-q')?.value ?? '').trim().toLowerCase();
  const listEl = () => sheetBody.querySelector<HTMLElement>('#lw-sheet-list');

  function drawSheet() {
    fill = null;
