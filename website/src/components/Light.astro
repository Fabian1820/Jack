      };
    } else if (sheet === 'activity') {
      html =
        '<h5>Comandos y herramientas</h5>' +
        (c.tools.length
          ? c.tools
              .slice(-100)
              .map((t) => `<div class="lw-item"><b>${esc(t.text)} · ${esc(t.status)}</b><span class="mono" style="font:11px/1.4 ui-monospace,Menlo,monospace;white-space:pre-wrap">${esc(t.detail)}</span></div>`)
              .join('')
          : '<span class="sec">Todavía no hay actividad de herramientas.</span>');
    } else if (sheet === 'formatted') {
      html = c.msgs
        .filter((m) => m.role === 'user' || m.role === 'assistant')
        .map((m) => `<span class="cap">${m.role === 'user' ? 'Tú' : 'Agente'}</span><div class="lw-rich">${md(m.text)}</div>`)
        .join('');
    } else if (sheet === 'options') {
      html =
        '<h5>Opciones de Light</h5>' +
        `<label class="lw-line">Modelo<select data-opt="model">${PROV[c.provider].models.map((m) => `<option${m === c.model ? ' selected' : ''}>${m}</option>`).join('')}</select></label>` +
        `<label class="lw-line">Agentes simultáneos en Light<select data-opt="conc">${[1, 2, 4, 8, 16, 32, 64].map((n) => `<option${n === maxConc ? ' selected' : ''}>${n}</option>`).join('')}</select></label>` +
        '<span class="sec" style="font-size:12px">El modo Normal conserva su configuración. Las sesiones inactivas de Claude se cierran en un máximo de 30 segundos si no tienen trabajo pendiente.</span>';
    } else if (sheet === 'usage') {
      const win = (t: string, p: number, r: string) =>
        `<div class="win"><div><span>${t}</span><span><b>${p} %</b><small>restante</small></span></div><div class="bar"><i style="width:${p}%;background:${p <= 10 ? '#ff453a' : p <= 30 ? '#ff9f0a' : '#30d158'}"></i></div><small>${r}</small></div>`;
      const card = (id: Prov, body: string) =>
        `<div class="lw-usage"><div class="who">${use(PROV[id].sym, `color:${PROV[id].tint}`)}${PROV[id].name}<small>Leído ${usageRead}</small></div>${body}</div>`;
      html =
        `<h5><span>Uso y límites<br><small class="cap" style="font-weight:400">Cuota restante de cada proveedor</small></span>` +
        `<span class="lw-line">${usageBusy ? '<i class="lw-spin"></i>' : ''}<button class="lw-b sm" type="button" data-act="usage" ${usageBusy ? 'disabled' : ''} title="Actualizar cuotas sin enviar mensajes a los modelos" aria-label="Actualizar cuotas">${use('i-refresh')}</button></span></h5>` +
        card('codex', win('Sesión · 5 h', 64, 'Se reinicia en 2 horas · 18:40') + win('Semanal · 7 d', 81, 'Se reinicia en 4 días · 28 nov, 9:00')) +
        card('claude', win('Sesión · 5 h', 27, 'Se reinicia en 48 minutos · 16:10') + win('Semanal · 7 d', 73, 'Se reinicia en 5 días · 29 nov, 9:00'));
    } else if (sheet === 'progress') {
      html =
        '<h5>Progreso y descargas<button class="lw-b" type="button" data-act="progress">Actualizar</button></h5><span class="sec">No hay tareas registradas.</span>';
    } else if (sheet === 'servers') {
      html =
        `<h5>Servidores<button class="lw-b" type="button" data-act="servers" ${serversBusy ? 'disabled' : ''}>Actualizar</button></h5>` +
        (serversBusy
          ? '<span class="sec">Consultando…</span>'
          : '<div class="lw-line"><span><span class="mono" style="font:12px ui-monospace,Menlo,monospace">npm run dev</span><br><small class="cap">5173</small></span><span class="lw-grow"></span><a>Abrir</a></div>');
    } else if (sheet === 'files') {
      const folder = base(c.path);
      html =
        `<h5>Archivos del proyecto</h5><span class="cap">${esc(c.path)}</span><div class="lw-list">` +
        (PROJECT_FILES[folder] ?? ['README.md'])
          .map((f) => `<button type="button" data-act="file" data-file="${esc(f)}"><span class="lw-line">${use('i-doc')}<span class="mono">${esc(f)}</span></span></button>`)
          .join('') +
        '</div>';
    } else if (sheet === 'resume') {
      html =
        '<h5>Retomar sesión de Claude Code</h5><div class="lw-list">' +
        (sessions.length
          ? sessions.map((s) => `<button type="button" data-act="session" data-id="${s.id}"><b>${esc(s.title)}</b><small>${esc(s.path)} · ${s.when}</small></button>`).join('')
          : '<span class="sec">No quedan sesiones por importar.</span>') +
        '</div>';
    } else if (sheet === 'new') {
      const auto = !newAgent.space;
      const hasMsg = Boolean(newAgent.msg.trim());
      const can = !auto || hasMsg;
      html =
        '<h5 class="big" style="flex-direction:column;align-items:flex-start;gap:3px">Nuevo agente<small class="sec" style="font-size:12px;font-weight:400">Elige dónde trabaja y con qué agente.</small></h5>' +
        `<div class="lw-field"><span class="cap">Space</span><select data-na="space"><option value="">Automático</option>${spaces().map((s) => `<option value="${esc(s)}"${s === newAgent.space ? ' selected' : ''}>${esc(base(s))}</option>`).join('')}</select>` +
        (auto ? '<small class="cap">El agente elige la carpeta del proyecto a partir del primer mensaje</small>' : '') +
        '</div>' +
        `<div class="lw-field"><span class="cap">Agente</span><div class="lw-cards">${(Object.keys(PROV) as Prov[]).map((id) => `<button type="button" data-act="prov" data-id="${id}" aria-pressed="${id === newAgent.provider}">${use(PROV[id].sym, `color:${PROV[id].tint}`)}<span>${PROV[id].name}</span>${id === 'stellar' ? '<em>BETA</em>' : ''}</button>`).join('')}</div></div>` +
        `<div class="lw-line" style="align-items:flex-start"><div class="lw-field lw-grow"><span class="cap">Modelo</span><select data-na="model">${PROV[newAgent.provider].models.map((m) => `<option${m === newAgent.model ? ' selected' : ''}>${m}</option>`).join('')}</select></div>` +
        (newAgent.provider !== 'opencode'
          ? `<div class="lw-field"><span class="cap">Esfuerzo</span><select data-na="effort">${[['low', 'Bajo'], ['medium', 'Medio'], ['high', 'Alto']].map(([v, t]) => `<option value="${v}"${v === newAgent.effort ? ' selected' : ''}>${t}</option>`).join('')}</select></div>`
          : '') +
        '</div>' +
        `<div class="lw-field"><span class="cap">${auto ? 'Primer mensaje' : 'Primer mensaje (opcional)'}</span><textarea class="txt" data-na="msg" aria-label="Primer mensaje" placeholder="${auto ? 'Describe la tarea; el agente buscará el proyecto: «arregla el login de Jack»…' : 'Describe la tarea y el agente empezará en cuanto lo crees…'}">${esc(newAgent.msg)}</textarea></div>`;
      foot =
        `<small>${can ? '⌘↩ para crear' : 'Escribe la tarea o elige una carpeta'}</small><span class="lw-grow"></span>` +
        '<button class="lw-b" type="button" data-act="close">Cancelar</button>' +
        `<button class="lw-b pri" type="button" data-act="create" ${can ? '' : 'disabled'}>${hasMsg ? 'Crear y enviar' : 'Crear agente'}</button>`;
    }
    sheetBody.innerHTML = html;
    sheetFoot.innerHTML = foot;
    fill?.();
  }
  function openSheet(kind: string) {
    closeMenus();
    sheet = kind;
    if (kind === 'servers') loadServers();
    veil.hidden = false;
    drawSheet();
    sheetBody.querySelector<HTMLElement>('input, textarea')?.focus({ preventScroll: true });
  }
  function closeSheet() {
    if (!sheet) return;
    sheet = '';
    veil.hidden = true;
    sheetBody.textContent = '';
  }
  function loadServers() {
    serversBusy = true;
    flashPolling();
    window.setTimeout(() => {
      serversBusy = false;
      if (sheet === 'servers') drawSheet();
    }, 800);
  }
  function createAgent() {
    const text = newAgent.msg.trim();
    if (!newAgent.space && !text) return;
    created += 1;
    const c = chat({
      id: 'new' + created,
      title: text ? (text.length > 44 ? text.slice(0, 43) + '…' : text) : 'Nuevo agente',
      provider: newAgent.provider,
      model: newAgent.model,
      path: newAgent.space || spaces()[0],
    });
    chats.push(c);
    newAgent.msg = '';
    select(c);
    if (text) start(c, text, []);
    input.focus({ preventScroll: true });
  }
  veil.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === veil) return closeSheet();
    const b = t.closest<HTMLElement>('[data-act]');
    if (!b || (b as HTMLButtonElement).disabled) return;
    const act = b.dataset.act;
    if (act === 'close') closeSheet();
    else if (act === 'chat') {
      const c = chats.find((x) => x.id === b.dataset.id);
      if (c) select(c);
    } else if (act === 'cmd') {
      // Como en la app: deja el comando en el borrador y devuelve el foco.
      input.value = cur.draft = (b.dataset.cmd ?? '') + ' ';
      closeSheet();
      renderComposer();
      input.focus({ preventScroll: true });
    } else if (act === 'file') {
      const f = b.dataset.file ?? '';
      if (f && !cur.files.includes(f)) cur.files.push(f);
      closeSheet();
      render();
    } else if (act === 'usage') {
      usageBusy = true;
      flashPolling();
      drawSheet();
      window.setTimeout(() => {
        usageBusy = false;
        usageRead = 'ahora';
        if (sheet === 'usage') drawSheet();
      }, 900);
    } else if (act === 'progress') flashPolling();
    else if (act === 'servers') {
      loadServers();
      drawSheet();
    } else if (act === 'session') {
      const s = sessions.find((x) => x.id === b.dataset.id);
      if (!s) return;
      sessions = sessions.filter((x) => x !== s);
      const c = chat({
        id: s.id,
        title: s.title,
        provider: 'claude',
        path: s.path,
        msgs: [
          { role: 'user', text: s.title + '.' },
          { role: 'assistant', text: 'Sesión retomada. Tengo el contexto de la última vez; dime por dónde seguimos.' },
        ],
      });
      chats.push(c);
      select(c);
    } else if (act === 'prov') {
      newAgent.provider = b.dataset.id as Prov;
      newAgent.model = PROV[newAgent.provider].models[0];
      drawSheet();
    } else if (act === 'create') {
      createAgent();
    }
  });
  veil.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.id === 'lw-q') fill?.();
    else if (t.dataset.na === 'msg') {
      const had = Boolean(newAgent.msg.trim());
      newAgent.msg = t.value;
      if (had !== Boolean(t.value.trim())) {
        // Solo cambia el pie (texto del botón); no se redibuja el campo para no perder el foco.
        const can = Boolean(newAgent.space) || !had;
        const btn = sheetFoot.querySelector<HTMLButtonElement>('[data-act="create"]')!;
        btn.textContent = had ? 'Crear agente' : 'Crear y enviar';
        btn.disabled = !can;
        sheetFoot.querySelector('small')!.textContent = can ? '⌘↩ para crear' : 'Escribe la tarea o elige una carpeta';
      }
    }
  });
  veil.addEventListener('change', (e) => {
    const t = e.target as HTMLSelectElement;
    if (t.dataset.opt === 'model') cur.model = t.value;
    else if (t.dataset.opt === 'conc') {
      maxConc = Number(t.value);
      pump();
    } else if (t.dataset.na === 'space') {
      newAgent.space = t.value;
      drawSheet();
    } else if (t.dataset.na === 'model') newAgent.model = t.value;
    else if (t.dataset.na === 'effort') newAgent.effort = t.value;
  });
  veil.addEventListener('keydown', (e) => {
    if (sheet === 'new' && e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      createAgent();
    }
  });

  // ── Compositor ──
  input.addEventListener('input', () => {
    cur.draft = input.value;
    renderComposer();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.isComposing) {
      if (e.shiftKey) return; // salto de línea
      e.preventDefault();
      if (!e.altKey) send(e.metaKey || e.ctrlKey);
    } else if (e.key === '.' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      if (active(cur)) endRun(cur);
    }
  });
  sendBtn.addEventListener('click', () => send());
  stopBtn.addEventListener('click', () => endRun(cur));
  $('lw-new').addEventListener('click', () => {
    newAgent.space = cur.path;
    newAgent.provider = cur.provider;
    newAgent.model = PROV[cur.provider].models[0];
    openSheet('new');
  });
  $('lw-attach').addEventListener('click', () => openSheet('files'));
  $('lw-cmds').addEventListener('click', () => openSheet('commands'));
  $('lw-act').addEventListener('click', () => openSheet('activity'));
  filesEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-f]');
    if (!b) return;
    cur.files.splice(Number(b.dataset.f), 1);
    render();
  });
  approvalEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ap]');
    if (b) answer(cur, b.dataset.ap as 'allow' | 'deny');
  });
  waitEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-w]');
    if (!b) return;
    const c = cur;
    if (b.dataset.w === 'now') return sendWaitingNow(c);
    const [m] = c.waiting.splice(Number(b.dataset.i), 1);
    if (b.dataset.w === 'edit' && m) {
      // Editar lo devuelve al cuadro de mensaje, delante de lo que ya hubiera.
      input.value = c.draft = [m.text, c.draft].filter(Boolean).join('\n\n');
      for (const f of m.files) if (!c.files.includes(f)) c.files.push(f);
      input.focus({ preventScroll: true });
    }
    render();
  });
  win.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!chatsMenu.hidden || !moreMenu.hidden) closeMenus();
    else if (sheet) closeSheet();
  });

  // ── Minimizar: Light suspende la interfaz ──
  function setMin(on: boolean) {
    minimized = on;
    closeMenus();
    win.classList.toggle('min', on);
    win.toggleAttribute('inert', on);
    desk.classList.toggle('away', on);
    flag('occluded', on);
    if (!on) {
      banner.hidden = true;
      stale = true;
      refresh();
    }
  }
  $('lw-min').addEventListener('click', () => setMin(true));
  $('lw-dock').addEventListener('click', () => setMin(false));
  banner.addEventListener('click', () => {
    const c = bannerChat;
    setMin(false);
    if (c) select(c);
  });
  new IntersectionObserver(([entry]) => {
    onScreen = entry.isIntersecting;
    refresh();
  }).observe(desk);
  document.addEventListener('visibilitychange', refresh);

  flag('chat', true);
  input.value = cur.draft;
  stale = true;
  refresh();
}
</script>
