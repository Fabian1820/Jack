      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }
  }
  function toggleMenu(btn: HTMLElement, menu: HTMLElement) {
    const open = menu.hidden;
    closeMenus();
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }
  chatsBtn.addEventListener('click', () => {
    chatsMenu.innerHTML =
      '<button type="button" role="menuitem" data-chat="">Buscar conversaciones…</button><hr>' +
      chats
        .map((c) => {
          const marks = (c.status === 'waiting' ? ' · En espera' : '') + (c.unread ? ' · Nuevo' : '');
          return `<button type="button" role="menuitem" data-chat="${c.id}">${esc(c.title + marks)}</button>`;
        })
        .join('');
