    let foot = CLOSE;
    const c = cur;
    if (sheet === 'conversations') {
      html =
        '<h5>Conversaciones</h5><input class="txt" id="lw-q" placeholder="Buscar por título o carpeta" aria-label="Buscar por título o carpeta"><div class="lw-list" id="lw-sheet-list"></div>';
      fill = () => {
        const q = query();
        listEl()!.innerHTML = chats
          .filter((x) => !q || x.title.toLowerCase().includes(q) || x.path.toLowerCase().includes(q))
          .map((x) => `<button type="button" data-act="chat" data-id="${x.id}"><b>${esc(x.title)}</b><small>${PROV[x.provider].name} · ${esc(x.path)}</small></button>`)
          .join('');
      };
    } else if (sheet === 'commands') {
      html =
        '<h5>Comandos</h5><input class="txt" id="lw-q" placeholder="Buscar comando" aria-label="Buscar comando"><div class="lw-list" id="lw-sheet-list"></div>';
      fill = () => {
        const q = query();
        const row = (prefix: string, name: string, hint: string, desc: string) =>
          !q || name.toLowerCase().includes(q) || desc.toLowerCase().includes(q)
            ? `<button type="button" data-act="cmd" data-cmd="${prefix + name}"><span class="mono">${esc(prefix + name + (hint ? ' ' + hint : ''))}</span><small style="white-space:normal">${esc(desc)}</small></button>`
            : '';
        listEl()!.innerHTML =
          '<span class="cap">Del proveedor</span>' +
