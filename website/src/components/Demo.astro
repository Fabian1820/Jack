</style>

<script>
const mac = document.getElementById('mac');
const stage = document.getElementById('stage');

if (mac && stage) {
  // La maqueta se dibuja a 1280×760 y se escala al ancho disponible.
  const fit = () => mac.style.setProperty('--k', String(stage.clientWidth / 1280));
  fit();
  new ResizeObserver(fit).observe(stage);

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const feed = $('feed');
  const perm = $('perm');
  const activity = $('activity');
  const activityText = $('activity-text');
  const tokens = $('act-tokens');
  const ph = $('ph');
  const send = $('send-btn');
  const sideDot = $('side-dot');
  const tabIcon = $('tab-icon');
  const sideSub = $('side-sub');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const paused = () => document.documentElement.dataset.light === 'on';
  const sleep = async (ms: number) => {
    await new Promise((r) => setTimeout(r, reduced ? 0 : ms));
    while (paused() && !reduced) await new Promise((r) => setTimeout(r, 250));
  };

  const WORKING = 'Claude Code está trabajando · lo leerá al terminar el paso · ⌘↩ interrumpe';
  const IDLE = 'Escribe a Claude Code…   ! Jack · / proveedor';
  const PROMPT = 'Divide ChatStore en módulos más pequeños y añade tests. Mantén la API pública igual.';
  const ANSWER =
    'Moví el almacenamiento a <b>ChatArchive</b> y dejé <b>ChatStore</b> como fachada, así que la API pública no cambia. Los <b>14 tests</b> pasan y Codex sigue ampliando la cobertura en su chat.';

  const bottom = () => (feed.scrollTop = feed.scrollHeight);
  const show = (id: string) => {
    const el = $(id);
    el.hidden = false;
    el.classList.add('pop');
    bottom();
    return el;
  };
  const work = (text: string | null) => {
    activity.hidden = text === null;
    if (text !== null) activityText.textContent = text;
  };
  const state = (value: 'running' | 'waiting' | 'idle', sub: string | null) => {
    sideDot.dataset.state = value;
    tabIcon.dataset.state = value;
    sideSub.hidden = sub === null;
    if (sub !== null) {
      sideSub.textContent = sub;
      sideSub.dataset.tone = value === 'waiting' ? 'amber' : '';
    }
    const busy = value !== 'idle';
    send.dataset.busy = String(busy);
    ph.textContent = busy ? WORKING : IDLE;
  };

  async function type(target: HTMLElement, html: string, speed: number) {
    const caret = document.createElement('span');
    caret.className = 'caret';
    const chunks = html.match(/<[^>]+>[^<]*<\/[^>]+>|[^<]/g) ?? [];
    let out = '';
    for (const chunk of chunks) {
      out += chunk;
      target.innerHTML = out;
      target.appendChild(caret);
      bottom();
      await sleep(chunk.length > 1 ? speed * 3 : speed);
    }
    caret.remove();
  }

  function reset() {
    feed.classList.remove('fade');
    for (const id of ['s-prompt', 's-think', 's-read', 's-rg', 's-edit', 's-delegate', 's-run', 's-answer']) {
      const el = $(id);
      el.hidden = true;
      el.classList.remove('pop');
    }
    $('prompt-text').textContent = '';
    $('answer-text').textContent = '';
    $('run-verb').textContent = 'Ejecutando';
    $('run-spin').hidden = false;
    $('run-ok').hidden = true;
    $('allow').classList.remove('press');
    perm.hidden = true;
    tokens.textContent = '';
    state('running', 'Preparando…');
    work('Preparando…');
  }

  async function play() {
    reset();
    await sleep(700);
    show('s-prompt');
    await type($('prompt-text'), PROMPT, 22);
    await sleep(350);
    work('Pensando');
    state('running', 'Pensando…');
    await sleep(700);
    show('s-think');
    await sleep(1000);
    show('s-read');
    tokens.textContent = '4K tokens';
    await sleep(500);
    show('s-rg');
    await sleep(600);
    work('Editando ChatArchive.swift');
    state('running', 'Editando ChatArchive.swift');
    show('s-edit');
    tokens.textContent = '8K tokens';
    await sleep(1600);
    show('s-delegate');
    await sleep(900);
    work('Ejecutando swift test --filter ChatStoreTests');
    state('running', 'Preparando…');
    show('s-run');
    await sleep(900);
    work('Esperando tu respuesta');
    state('waiting', 'Permiso: Ejecutar un comando');
    perm.hidden = false;
    perm.classList.add('pop');
    bottom();
    await sleep(1800);
    $('allow').classList.add('press');
    await sleep(380);
    perm.hidden = true;
    $('run-verb').textContent = 'Ejecutó';
    $('run-spin').hidden = true;
    $('run-ok').hidden = false;
    work('Escribiendo respuesta');
    state('running', 'Escribiendo respuesta…');
    tokens.textContent = '12K tokens';
    await sleep(600);
    show('s-answer');
    await type($('answer-text'), ANSWER, 14);
    await sleep(300);
    work(null);
    state('idle', null);
    await sleep(4500);
    feed.classList.add('fade');
    await sleep(600);
  }

  let started = false;
  let visible = false;
  const untilVisible = () =>
    new Promise<void>((resolve) => {
      const check = () => (visible ? resolve() : setTimeout(check, 250));
      check();
    });

  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !started) {
        started = true;
        (async () => {
          if (reduced) {
            await play();
            feed.classList.remove('fade');
            return;
          }
          for (;;) {
            await untilVisible();
            await play();
          }
        })();
      }
    },
    { threshold: 0.25 },
  ).observe(stage);
}
</script>
