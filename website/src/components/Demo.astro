<style>
.stage {
  aspect-ratio: 1280 / 760;
  width: 100%;
  position: relative;
}
.mac {
  --canvas: #0e0e0f;
  --chrome: #161618;
  --sel: rgba(255, 255, 255, 0.085);
  --panel: rgba(255, 255, 255, 0.05);
  --panel2: rgba(255, 255, 255, 0.08);
  --code: rgba(255, 255, 255, 0.035);
  --hair: rgba(255, 255, 255, 0.085);
  --txt: rgba(255, 255, 255, 0.85);
  --txt2: rgba(255, 255, 255, 0.73);
  --muted: rgba(235, 235, 245, 0.6);
  --faint: rgba(235, 235, 245, 0.3);
  --accent: #0a84ff;
  --green: #30d158;
  --amber: #ff9f0a;
  --red: #ff453a;
  --add: #1f4d2b;
  --rem: #5c2324;
  --ui: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif;
  --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  width: 1280px;
  height: 760px;
  position: absolute;
  top: 0;
  left: 0;
  transform: scale(var(--k, 0.92));
  transform-origin: 0 0;
  background: var(--canvas);
  color: var(--txt);
  font-family: var(--ui);
  font-size: 12.5px;
  line-height: 1.3;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  box-shadow:
    0 40px 120px -20px #000c,
    0 0 0 1px #0008;
  flex-direction: column;
  display: flex;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}
.mac :is(div, span, b, em, i, svg, nav, aside, code, kbd) {
  box-sizing: border-box;
}
.mac b,
.mac em,
.mac kbd {
  font-style: normal;
}
.mac svg.i {
  flex: none;
  width: 13px;
  height: 13px;
}

.mac-body {
  flex: 1;
  grid-template-columns: 264px 1px minmax(0, 1fr);
  min-height: 0;
  display: grid;
}
.vsep {
  background: var(--hair);
}

/* ── Barra lateral ── */
.side {
  background: var(--chrome);
  flex-direction: column;
  min-width: 0;
  display: flex;
}
.side-head {
  height: 38px;
  flex: none;
  align-items: center;
  padding-right: 12px;
  display: flex;
  position: relative;
}
.lights {
  gap: 8px;
  display: flex;
  position: absolute;
  left: 8px;
}
.lights i {
  border-radius: 50%;
  width: 12px;
  height: 12px;
}
.lights .r {
  background: #ff5f57;
}
.lights .y {
  background: #febc2e;
}
.lights .g {
  background: #28c840;
}
.side-title {
  color: var(--txt2);
  margin-left: 80px;
  font-size: 13px;
  font-weight: 600;
}
.ghost {
  color: var(--muted);
  margin-left: auto;
}
.nav {
  flex-direction: column;
  gap: 1px;
  padding: 2px 8px 8px;
  display: flex;
}
.nrow {
  height: 27px;
  color: var(--txt);
  border-radius: 6px;
  align-items: center;
  gap: 8px;
  padding: 0 8px;
  display: flex;
}
.nrow .i {
  color: var(--muted);
  width: 14px;
  height: 14px;
}
.nrow span {
  flex: 1;
}
.nrow kbd {
  color: var(--faint);
  font-family: var(--ui);
  font-size: 10.5px;
  min-width: 0;
  height: auto;
  background: none;
  border: 0;
  padding: 0;
  display: inline;
}
.nrow.search {
  background: var(--panel);
  margin-top: 5px;
}
.nrow.search span {
  color: var(--muted);
}

.list {
  flex-direction: column;
  flex: 1;
  gap: 1px;
  min-height: 0;
  padding: 6px 8px 0;
  display: flex;
  overflow: hidden;
}
.list-head {
  color: var(--muted);
  justify-content: space-between;
  align-items: center;
  height: 24px;
  margin-bottom: 2px;
  padding: 0 8px;
  font-size: 11.5px;
  font-weight: 500;
  display: flex;
}
.list-tools {
  color: var(--muted);
  gap: 9px;
  display: flex;
}
.list-tools .i {
  width: 12px;
  height: 12px;
}
.prow {
  height: 28px;
  align-items: center;
  gap: 7px;
  margin-top: 4px;
  padding: 0 8px;
  display: flex;
}
.prow .i {
  color: var(--muted);
  width: 13px;
  height: 13px;
}
.prow b {
  font-size: 12.5px;
  font-weight: 500;
}
.prow em {
  color: var(--faint);
  font-size: 11px;
}
.live {
  color: var(--muted);
  align-items: center;
  gap: 4px;
  margin-left: auto;
  font-size: 11px;
  display: flex;
}
.live i {
  background: var(--green);
  border-radius: 50%;
  width: 5px;
  height: 5px;
}
.chev {
  width: 9px;
  height: 9px;
  color: var(--faint);
  flex: none;
  transition: transform 0.2s;
}
.prow > .chev:last-child {
  margin-left: auto;
}
.prow .live ~ .chev {
  margin-left: 6px;
}
.chev.open {
  transform: rotate(90deg);
}

.srow {
  grid-template-columns: 12px 12px minmax(0, 1fr) auto;
  align-items: center;
  column-gap: 7px;
  border-radius: 6px;
  padding: 5px 8px 5px 18px;
  display: grid;
}
.srow.sel {
  background: var(--sel);
}
.srow .plogo {
  width: 12px;
  height: 12px;
}
.stitle {
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--txt);
  font-size: 12.5px;
  overflow: hidden;
}
.stitle.strong {
  font-weight: 600;
}
.sage {
  color: var(--faint);
  font-variant-numeric: tabular-nums;
  grid-column: 4;
  font-size: 10.5px;
}
.beta {
  color: var(--muted);
  letter-spacing: 0.04em;
  background: var(--panel2);
  border-radius: 3px;
  grid-column: 4;
  padding: 1px 4px;
  font-size: 8.5px;
  font-weight: 600;
}
.srow.wb {
  grid-template-columns: 12px 12px minmax(0, 1fr) auto auto;
}
.srow.wb .sage {
  grid-column: 5;
}
.ssub {
  color: var(--muted);
  text-overflow: ellipsis;
  white-space: nowrap;
  grid-column: 3 / -1;
