                      <span class="cbtn"><svg class="i"><use href="#i-folder-plus"></use></svg></span>
                      <span class="cbtn"><svg class="i"><use href="#i-aside"></use></svg></span>
                      <span class="cbtn"><svg class="i"><use href="#i-paperclip"></use></svg></span>
                      <span class="cbtn"><svg class="i"><use href="#i-mic"></use></svg></span>
                      <span class="send" id="send-btn" data-busy="true">
                        <svg class="i s-stop"><use href="#i-stop"></use></svg>
                        <svg class="i s-up"><use href="#i-arrow-up"></use></svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="vsep"></div>

              <!-- Panel de terminal -->
              <div class="panel">
                <div class="strip small">
                  <div class="ptab on">
                    <svg class="i"><use href="#i-terminal"></use></svg><span>Terminal 1</span>
                  </div>
                  <span class="sbtn"><svg class="i"><use href="#i-plus"></use></svg></span>
                  <span class="cspace"></span>
                  <span class="sbtn"><svg class="i"><use href="#i-x"></use></svg></span>
                </div>
                <div class="term">
                  <div><span class="tp">ruben@mac jack %</span> git status -sb</div>
                  <div class="tdim">## main...origin/main [ahead 2]</div>
                  <div><span class="tr"> M</span> Sources/JackCore/ChatStore.swift</div>
                  <div><span class="tr">??</span> Sources/JackCore/ChatArchive.swift</div>
                  <div><span class="tp">ruben@mac jack %</span> <span class="tcursor"></span></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ───────── Barra de estado ───────── -->
        <div class="status">
          <div class="sleft">
            <span class="quota">
              <svg class="plogo" style="color: rgba(255, 255, 255, 0.85)"><use href="#p-codex"></use></svg>
