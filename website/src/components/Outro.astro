  align-items: center;
  display: flex;
}
.big {
  --mx: 50%;
  background: radial-gradient(
    260px circle at var(--mx) var(--my, 50%),
    #fff,
    var(--accent-2) 30%,
    var(--accent) 55%,
    #3a3f52 85%
  );
  color: #0000;
  user-select: none;
  -webkit-background-clip: text;
  background-clip: text;
  max-width: 100%;
  margin: 0 0 40px;
