<style>
.hero {
  isolation: isolate;
  flex-direction: column;
  min-height: 100svh;
  padding: 120px 0 0;
  display: flex;
  position: relative;
  overflow: hidden;
}
.glow {
  filter: blur(90px);
  z-index: -1;
  pointer-events: none;
  border-radius: 50%;
  position: absolute;
}
.g1 {
  background: radial-gradient(circle, #ff6a2b38, #0000 65%);
  width: 620px;
  height: 620px;
  animation: 14s ease-in-out infinite alternate drift;
  top: 60px;
  right: -120px;
}
.g2 {
  background: radial-gradient(circle, #7aa2ff24, #0000 65%);
  width: 520px;
  height: 520px;
  animation: 18s ease-in-out infinite alternate-reverse drift;
  top: 260px;
  left: -160px;
}
@keyframes drift {
  to {
    transform: translate(-60px, 40px) scale(1.12);
  }
}
.grid-bg {
  z-index: -2;
  background-image: linear-gradient(#ffffff09 1px, #0000 1px),
    linear-gradient(90deg, #ffffff09 1px, #0000 1px);
  background-size: 56px 56px;
  position: absolute;
  inset: 0;
  -webkit-mask-image: radial-gradient(80% 70% at 60% 30%, #000 30%, #0000 75%);
  mask-image: radial-gradient(80% 70% at 60% 30%, #000 30%, #0000 75%);
}
.hero-inner {
  flex: 1;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  align-items: center;
  gap: clamp(32px, 5vw, 72px);
  padding-bottom: 64px;
  display: grid;
}
.pill {
  border: 1px solid var(--line-2);
  color: var(--muted);
  background: #ffffff08;
  border-radius: 999px;
  align-items: center;
  gap: 10px;
  padding: 6px 14px 6px 10px;
  font-size: 13px;
  transition:
    border-color 0.2s,
    color 0.2s;
  display: inline-flex;
}
.pill:hover {
  color: var(--text);
  border-color: #ff6a2b80;
}
.pill .dot {
  background: var(--accent);
  border-radius: 50%;
  width: 8px;
  height: 8px;
  animation: 2s infinite ping;
  box-shadow: 0 0 #ff6a2b99;
}
.pill .arrow {
  transition: transform 0.2s;
}
.pill:hover .arrow {
  transform: translate(3px);
}
@keyframes ping {
  70% {
    box-shadow: 0 0 0 8px #ff6a2b00;
  }
  to {
    box-shadow: 0 0 #ff6a2b00;
  }
}
h1 {
  letter-spacing: -0.05em;
  margin: 26px 0 24px;
  font-size: clamp(46px, 7.4vw, 96px);
  font-weight: 600;
  line-height: 0.96;
}
h1 .line {
  animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) both rise;
  display: block;
}
h1 .line:nth-child(2) {
  padding-bottom: 0.08em;
  animation-delay: 0.12s;
}
@keyframes rise {
  0% {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(30px);
  }
}
.lede {
  color: var(--muted);
  text-wrap: pretty;
  max-width: 540px;
  margin: 0 0 32px;
  font-size: clamp(16px, 1.55vw, 19px);
  animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.24s both rise;
}
.lede b {
  color: var(--text);
  font-weight: 500;
}
.ctas {
  flex-wrap: wrap;
  gap: 12px;
  animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.34s both rise;
  display: flex;
}
.cmd {
  all: unset;
  box-sizing: border-box;
  border: 1px dashed var(--line-2);
  width: 100%;
  max-width: 540px;
  font-family: var(--mono);
  color: var(--muted);
  cursor: pointer;
  border-radius: 10px;
  align-items: center;
  gap: 10px;
  margin-top: 22px;
  padding: 11px 14px;
  font-size: 12.5px;
  transition:
    border-color 0.2s,
    background 0.2s;
  animation: 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.44s both rise;
  display: flex;
}
.cmd:hover,
.cmd:focus-visible {
  background: #ffb15c0a;
  border-color: #ffb15c80;
}
.cmd .prompt {
  color: var(--accent);
}
.cmd code {
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
  overflow: hidden;
}
.cmd .copy-state {
  color: var(--dim);
  border: 1px solid var(--line-2);
  border-radius: 6px;
  padding: 2px 8px;
  font-size: 11px;
}
.cmd.copied .copy-state {
  color: var(--green);
  border-color: #5ee59a66;
}
.meta {
  font-family: var(--mono);
  color: var(--dim);
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin: 22px 0 0;
  font-size: 12px;
  display: flex;
}
.meta i {
  background: var(--dim);
  border-radius: 50%;
  width: 3px;
  height: 3px;
}
.stage {
  animation: 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both rise;
  position: relative;
}
.stage:before {
  content: '';
  background: conic-gradient(from var(--a, 0deg), transparent 0 70%, #ff8c46e6 82%, transparent 92%);
  -webkit-mask-composite: xor;
  z-index: 2;
  pointer-events: none;
  border-radius: 17px;
  padding: 1px;
  animation: 6s linear infinite spin;
  position: absolute;
  inset: -1px;
  -webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
  -webkit-mask-position:
    0 0,
    0 0;
  -webkit-mask-size: auto, auto;
  -webkit-mask-repeat: repeat, repeat;
  -webkit-mask-clip: content-box, border-box;
  -webkit-mask-origin: content-box, border-box;
  mask-composite: exclude;
  mask-mode: match-source, match-source;
}
@property --a {
  syntax: '<angle>';
  inherits: false;
  initial-value: 0deg;
}
@keyframes spin {
  to {
    --a: 360deg;
  }
}
.ascii-window {
  cursor: crosshair;
}
#ascii {
  aspect-ratio: 1/0.92;
  touch-action: pan-y;
  width: 100%;
}
.statusline {
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  color: var(--dim);
  justify-content: space-between;
  gap: 12px;
  padding: 9px 14px;
  font-size: 11.5px;
  display: flex;
}
.statusline .live {
  background: var(--green);
  width: 7px;
  height: 7px;
  box-shadow: 0 0 10px var(--green);
  border-radius: 50%;
  margin-right: 6px;
  animation: 1.4s steps(2, end) infinite blink;
  display: inline-block;
}
@keyframes blink {
  50% {
    opacity: 0.35;
  }
}
.marquee {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: #ffffff03;
  position: relative;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, #0000, #000 12% 88%, #0000);
  mask-image: linear-gradient(90deg, #0000, #000 12% 88%, #0000);
}
.track {
  width: max-content;
  animation: 40s linear infinite slide;
  display: flex;
}
.marquee:hover .track {
  animation-play-state: paused;
}
.item {
  font-family: var(--mono);
  color: var(--muted);
  white-space: nowrap;
  align-items: center;
  gap: 12px;
  padding: 18px 34px;
  font-size: 14px;
  display: flex;
}
.item .glyph {
  color: var(--accent);
  font-size: 9px;
}
@keyframes slide {
  to {
    transform: translate(-50%);
  }
}
@media (width<=980px) {
  .hero {
    padding-top: 96px;
  }
  .hero-inner {
    grid-template-columns: 1fr;
  }
  .stage {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }
}
@media (width<=520px) {
  .statusline .hint {
    display: none;
  }
}
</style>

