<Application
    x:Class="Jack.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="JackCanvasBrush" Color="#0E0E0F" />
                    <SolidColorBrush x:Key="JackChromeBrush" Color="#161618" />
                    <SolidColorBrush x:Key="JackSelectionBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="JackHoverBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="JackPanelBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="JackPanelStrongBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="JackHairlineBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="JackMutedBrush" Color="#9A9AA0" />
                    <SolidColorBrush x:Key="JackFaintBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="JackScrimBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="JackCanvasBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="JackChromeBrush" Color="#F3F3F5" />
                    <SolidColorBrush x:Key="JackSelectionBrush" Color="#13000000" />
                    <SolidColorBrush x:Key="JackHoverBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="JackPanelBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="JackPanelStrongBrush" Color="#11000000" />
                    <SolidColorBrush x:Key="JackHairlineBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="JackMutedBrush" Color="#6B6B72" />
                    <SolidColorBrush x:Key="JackFaintBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="JackScrimBrush" Color="#55000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Estilos reutilizables para la interfaz construida en código. Los pinceles van por ThemeResource
                 dentro de los estilos, así cambian con el tema claro/oscuro sin consultarlos desde C#. -->
            <FontFamily x:Key="JackMonoFont">Cascadia Mono</FontFamily>

            <Style x:Key="JackSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource JackMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="JackCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource JackMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="JackMono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource JackMonoFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="JackBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JackPanelStrongBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="JackPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JackPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JackHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="JackCodeBlock" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JackPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JackHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <Style x:Key="JackQuote" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="Padding" Value="12,2,0,2" />
            </Style>

            <Style x:Key="JackRule" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Background" Value="{ThemeResource JackHairlineBrush}" />
            </Style>

            <Style x:Key="JackCell" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource JackHairlineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="JackChip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JackPanelStrongBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
