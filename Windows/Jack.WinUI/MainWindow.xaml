<Window
    x:Class="Jack.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Jack.Core"
    xmlns:local="using:Jack.WinUI"
    Title="Jack">
    <Grid x:Name="Root" Background="{ThemeResource JackCanvasBrush}">
        <Grid.Resources>
            <!-- Plantillas de los mensajes de la conversación -->
            <DataTemplate x:Key="UserTurn" x:DataType="local:Turn">
                <Border HorizontalAlignment="Right" MaxWidth="540" CornerRadius="18,18,4,18" Padding="16,11"
                        Background="{StaticResource JackAccentBrush}">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" LineHeight="21" FontWeight="SemiBold"
                               Foreground="{StaticResource JackInkBrush}" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AgentTurn" x:DataType="local:Turn">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Top"
                            Background="{x:Bind local:Look.Tile(Provider)}">
                        <TextBlock Text="{x:Bind local:Look.Initials(Provider)}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind ProviderTitle}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource JackTextDimBrush}" />
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" LineHeight="23"
                                   Foreground="{ThemeResource JackTextBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ToolTurn" x:DataType="local:Turn">
                <Border Margin="42,0,0,0" CornerRadius="12" Padding="12,9"
                        Background="{ThemeResource JackPanelBrush}" BorderThickness="1"
                        BorderBrush="{ThemeResource JackStrokeBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Running}" Visibility="{x:Bind ShowRunning}"
                                      Foreground="{StaticResource JackAmberBrush}" />
                        <FontIcon Glyph="&#xE73E;" FontSize="15" Visibility="{x:Bind ShowDone}"
                                  Foreground="{StaticResource JackGreenBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{ThemeResource JackTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}" FontSize="12" FontFamily="Cascadia Code, Consolas"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{ThemeResource JackTextDimBrush}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="DiffTurn" x:DataType="local:Turn">
                <Border Margin="42,0,0,0" CornerRadius="12" BorderThickness="1"
                        Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                    <StackPanel>
                        <Border CornerRadius="11,11,0,0" Padding="14,9" Background="{ThemeResource JackPanelBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource JackTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12.5" FontWeight="SemiBold"
                                           FontFamily="Cascadia Code, Consolas" Foreground="{ThemeResource JackTextBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" FontSize="12.5" FontWeight="SemiBold"
                                           FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource JackGreenBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{x:Bind Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DiffLine">
                                    <Grid Background="{x:Bind Tint}" Padding="14,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Mark}" FontFamily="Cascadia Code, Consolas" FontSize="12.5"
                                                   Foreground="{ThemeResource JackTextDimBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Cascadia Code, Consolas"
                                                   FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource JackTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="8" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:TurnSelector x:Key="TurnSelector" User="{StaticResource UserTurn}" Agent="{StaticResource AgentTurn}"
                                Tool="{StaticResource ToolTurn}" Diff="{StaticResource DiffTurn}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Aurora: halos de color detrás de los paneles de cristal (se rellena en código) -->
        <Grid x:Name="Aurora" Grid.RowSpan="3" Grid.ColumnSpan="2" IsHitTestVisible="False" />

        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" CornerRadius="7" VerticalAlignment="Center"
                    Background="{StaticResource JackAccentBrush}">
                <TextBlock Text="J" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource JackInkBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="Jack" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{ThemeResource JackTextBrush}" />
        </Grid>

        <!-- Barra lateral -->
        <Border Grid.Row="1" Margin="12,0,6,8" CornerRadius="18" BorderThickness="1"
                Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
            <Grid Padding="12,12,12,10" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="NewConversationButton" Click="NewConversation_Click" HorizontalAlignment="Stretch"
                        Style="{StaticResource JackCta}" Margin="3" AutomationProperties.Name="Nuevo agente"
                        ToolTipService.ToolTip="Nuevo agente (Ctrl+N)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="Nuevo agente" />
                        <Border Grid.Column="2" CornerRadius="5" Padding="6,1" Background="#26190B04" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl N" FontSize="10.5" FontWeight="SemiBold" Opacity="0.8" />
                        </Border>
                    </Grid>
                </Button>

                <Grid Grid.Row="1" Margin="6,4,6,0">
                    <TextBlock Text="AGENTES" FontSize="11" FontWeight="Bold" CharacterSpacing="120"
                               Foreground="{ThemeResource JackTextFaintBrush}" />
                    <Border HorizontalAlignment="Right" CornerRadius="9" Padding="7,1"
                            Background="{ThemeResource JackPanelStrongBrush}">
                        <TextBlock x:Name="AgentCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource JackTextDimBrush}" />
                    </Border>
                </Grid>

                <ListView x:Name="ConversationList" Grid.Row="2" SelectionMode="Single"
                          SelectionChanged="ConversationList_SelectionChanged"
                          AutomationProperties.Name="Agentes">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#22FF7A33" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2CFF7A33" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#26FF7A33" />
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FF8A3D" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:ChatConversation">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center"
                                        Background="{x:Bind local:Look.Tile(Provider)}">
                                    <TextBlock Text="{x:Bind local:Look.Initials(Provider)}" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                               Foreground="{ThemeResource JackTextBrush}" />
                                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="12"
                                               Foreground="{ThemeResource JackTextDimBrush}">
                                        <Run Text="{x:Bind ProviderTitle}" /><Run Text=" · " /><Run Text="{x:Bind ProjectName}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Panel principal -->
        <Border Grid.Row="1" Grid.Column="1" Margin="6,0,12,8" CornerRadius="18" BorderThickness="1"
                Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
            <Grid>
                <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="640" Margin="24">
                        <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse x:Name="RingOuter" Width="150" Height="150" StrokeThickness="1.5" Opacity="0.35"
                                     Stroke="{StaticResource JackAccentBrush}" />
                            <Ellipse x:Name="RingInner" Width="116" Height="116" StrokeThickness="1.5" Opacity="0.6"
                                     Stroke="{StaticResource JackAccentBrush}" />
                            <Ellipse Width="86" Height="86" Fill="#FF5A1F" Opacity="0.18" />
                            <Ellipse Width="70" Height="70" Fill="{StaticResource JackAccentBrush}" />
                            <FontIcon Glyph="&#xE8BD;" FontSize="28" Foreground="{StaticResource JackInkBrush}" />
                        </Grid>
                        <TextBlock Text="Tus agentes, en un solo lugar" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="34" FontWeight="Bold"
                                   Foreground="{ThemeResource JackTitleBrush}" />
                        <TextBlock Text="Elige la carpeta de un proyecto y un proveedor. Cada agente trabaja en su propia conversación."
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="15" LineHeight="22"
                                   Foreground="{ThemeResource JackTextDimBrush}" />
                        <Button Click="NewConversation_Click" HorizontalAlignment="Center" Margin="0,10,0,10"
                                Style="{StaticResource JackCta}" Padding="26,13" FontSize="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE710;" FontSize="15" />
                                <TextBlock Text="Nuevo agente" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="14" Padding="14" BorderThickness="1"
                                    Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                <StackPanel Spacing="10">
                                    <Border x:Name="TileCodex" Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left">
                                        <TextBlock Text="CX" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Codex" FontWeight="SemiBold" Foreground="{ThemeResource JackTextBrush}" />
                                        <TextBlock Text="El agente de OpenAI para tu terminal." TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{ThemeResource JackTextDimBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="14" Padding="14" BorderThickness="1"
                                    Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                <StackPanel Spacing="10">
                                    <Border x:Name="TileClaude" Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left">
                                        <TextBlock Text="CC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Claude Code" FontWeight="SemiBold" Foreground="{ThemeResource JackTextBrush}" />
                                        <TextBlock Text="El agente de Anthropic para programar." TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{ThemeResource JackTextDimBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="14" Padding="14" BorderThickness="1"
                                    Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                <StackPanel Spacing="10">
                                    <Border x:Name="TileOpenCode" Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left">
                                        <TextBlock Text="OC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="White" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="OpenCode" FontWeight="SemiBold" Foreground="{ThemeResource JackTextBrush}" />
                                        <TextBlock Text="Agente de código abierto." TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{ThemeResource JackTextDimBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ConversationView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="22,16" ColumnSpacing="14" BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource JackStrokeBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeaderTile" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderInitials" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="ConversationTitle" TextTrimming="CharacterEllipsis" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{ThemeResource JackTextBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="7" Padding="8,2" Background="{ThemeResource JackPanelStrongBrush}">
                                    <TextBlock x:Name="ConversationProvider" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource JackTextBrush}" />
                                </Border>
                                <TextBlock x:Name="ConversationPath" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                           FontFamily="Cascadia Code, Consolas" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource JackTextDimBrush}" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="14" Padding="11,5" VerticalAlignment="Center"
                                Background="#26FFB020">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource JackAmberBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CLI sin conectar" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource JackAmberTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="780" Margin="24,22" Spacing="14" HorizontalAlignment="Stretch">
                            <Border x:Name="ReadyCard" CornerRadius="16" Padding="20" BorderThickness="1"
                                    Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top"
                                            Background="{StaticResource JackAccentBrush}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{StaticResource JackInkBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Conversación preparada" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource JackTextBrush}" />
                                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{ThemeResource JackTextDimBrush}"
                                                   Text="Todavía no hay conexión con la CLI del agente: aún no puede ejecutar tareas ni modificar el proyecto." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="Transcript" ItemTemplateSelector="{StaticResource TurnSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="14">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="18" />
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                        </StackPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="24,6,24,16">
                        <StackPanel MaxWidth="780" Spacing="8">
                            <Border CornerRadius="18" BorderThickness="1" Padding="14,10,10,10"
                                    Background="{ThemeResource JackPanelStrongBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="Composer" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="40" MaxHeight="160" Padding="0,8"
                                             AutomationProperties.Name="Mensaje">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#8A93AD" />
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="9" Padding="8,4" Background="{ThemeResource JackPanelBrush}"
                                                BorderThickness="1" BorderBrush="{ThemeResource JackStrokeBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border x:Name="ComposerTile" Width="18" Height="18" CornerRadius="6" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ComposerInitials" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                                </Border>
                                                <TextBlock x:Name="ComposerProvider" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{ThemeResource JackTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="9" Padding="8,4" Background="{ThemeResource JackPanelBrush}"
                                                BorderThickness="1" BorderBrush="{ThemeResource JackStrokeBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource JackTextDimBrush}" />
                                                <TextBlock x:Name="ComposerFolder" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource JackTextDimBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="3" IsEnabled="False" Width="42" Height="42" Padding="0"
                                                Style="{StaticResource JackCta}" AutomationProperties.Name="Enviar">
                                            <FontIcon Glyph="&#xE724;" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock Text="La conexión con la CLI está pendiente: todavía no se pueden enviar mensajes."
                                       HorizontalAlignment="Center" FontSize="11.5"
                                       Foreground="{ThemeResource JackTextFaintBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Barra de estado -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Padding="24,0,22,2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{ThemeResource JackTextFaintBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Sin agente seleccionado" FontSize="12"
                           Foreground="{ThemeResource JackTextDimBrush}" />
            </StackPanel>
            <TextBlock x:Name="StatusPath" Grid.Column="1" FontSize="12" FontFamily="Cascadia Code, Consolas"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{ThemeResource JackTextFaintBrush}" />
            <TextBlock Grid.Column="2" Text="Jack para Windows" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource JackTextFaintBrush}" />
        </Grid>
    </Grid>
</Window>
