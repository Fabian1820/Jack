<Window
    x:Class="Jack.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Jack.Core"
    Title="Jack">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock Text="J" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="Jack" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,4,12,12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="NewConversationButton" Click="NewConversation_Click" HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Nuevo agente" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Row="1" Text="Agentes" Margin="4,4,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="ConversationList" Grid.Row="2" SelectionMode="Single"
                      SelectionChanged="ConversationList_SelectionChanged"
                      AutomationProperties.Name="Agentes">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:ChatConversation">
                        <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="36" Height="36" DisplayName="{x:Bind ProviderTitle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ProviderTitle}" /><Run Text=" · " /><Run Text="{x:Bind ProjectName}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8BD;" FontSize="30" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Crea tu primer agente" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Elige la carpeta de un proyecto y un proveedor para preparar una conversación."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="NewConversation_Click" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Style="{ThemeResource AccentButtonStyle}" Padding="20,8" Content="Nuevo agente" />
                </StackPanel>

                <Grid x:Name="ConversationView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="24,16" ColumnSpacing="14" BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="HeaderPicture" Width="44" Height="44" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ConversationTitle" TextTrimming="CharacterEllipsis" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ConversationDescription" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="760" Margin="24" Spacing="16" HorizontalAlignment="Stretch">
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Conversación preparada"
                                     Message="Todavía no hay conexión con la CLI del agente: aún no puede ejecutar tareas ni modificar el proyecto." />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Padding="24,8,24,20">
                        <Grid MaxWidth="760" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Composer" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="48" MaxHeight="160" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Mensaje" />
                            <Button Grid.Column="1" IsEnabled="False" VerticalAlignment="Bottom" Width="48" Height="48"
                                    Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Enviar">
                                <FontIcon Glyph="&#xE724;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
