<Window
    x:Class="Jack.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Jack.WinUI"
    Title="Jack">
    <Grid x:Name="Root" Background="{ThemeResource JackCanvasBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAgentShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fondos: barra lateral (chrome) y lienzo del chat, a pantalla completa. -->
        <Border Grid.RowSpan="2" Background="{ThemeResource JackChromeBrush}" />
        <Border Grid.RowSpan="2" Grid.Column="1" Background="{ThemeResource JackCanvasBrush}"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource JackHairlineBrush}" />

        <!-- Barra de título arrastrable: marca a la izquierda, nombre del agente a la derecha. -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/jack.png" Width="20" Height="20" />
                <TextBlock Text="Jack" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Padding="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="ConversationTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock x:Name="ConversationDescription" Style="{StaticResource JackCaption}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ui:SidebarView x:Name="Sidebar" Grid.Row="1" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="ErrorBar" Grid.Row="0" Severity="Error" IsOpen="False" IsClosable="True"
                     Margin="12,4,12,0" Closed="ErrorBar_Closed" />

            <Grid x:Name="EmptyState" Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420" Margin="24">
                    <FontIcon Glyph="&#xE8BD;" FontSize="30" Foreground="{ThemeResource JackFaintBrush}" Margin="0,0,0,6" />
                    <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyBody" TextAlignment="Center" Style="{StaticResource JackSecondaryText}" />
                    <Button x:Name="EmptyNewAgentButton" Click="NewAgent_Click" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Style="{ThemeResource AccentButtonStyle}" Padding="18,7" Content="Nuevo agente" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ConversationView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TranscriptView x:Name="Transcript" Grid.Row="0" />

                <Grid x:Name="ApprovalsHost" Grid.Row="1" Padding="24,8,24,0" Visibility="Collapsed">
                    <StackPanel x:Name="ApprovalsBox" HorizontalAlignment="Center" Spacing="8" />
                </Grid>

                <Grid x:Name="ComposerHost" Grid.Row="2" Padding="24,8,24,18">
                    <StackPanel x:Name="ComposerBox" HorizontalAlignment="Center" Spacing="8">
                        <StackPanel x:Name="QueueHost" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                        <Border CornerRadius="12" BorderThickness="1" Padding="12,10,10,8"
                                Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackHairlineBrush}">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="AttachmentsHost" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                                <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="40" MaxHeight="200" FontSize="14"
                                         Background="Transparent" BorderThickness="0" Padding="0,6"
                                         PlaceholderText="Escribe un mensaje…  (Intro envía, Mayús+Intro nueva línea)"
                                         AutomationProperties.Name="Mensaje"
                                         PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{ThemeResource ControlFillColorTertiary}" />
                                        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
                                        <Style TargetType="ComboBox">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="Padding" Value="8,3,0,3" />
                                        </Style>
                                    </Grid.Resources>
                                    <Button x:Name="AttachButton" Click="Attach_Click" Width="30" Height="30" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="15"
                                            ToolTipService.ToolTip="Adjuntar archivos" AutomationProperties.Name="Adjuntar archivos">
                                        <FontIcon Glyph="&#xE723;" FontSize="14" />
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                                        <ComboBox x:Name="ModelBox" MinWidth="120" AutomationProperties.Name="Modelo"
                                                  ToolTipService.ToolTip="Modelo" SelectionChanged="ModelBox_SelectionChanged" />
                                        <ComboBox x:Name="EffortBox" MinWidth="90" AutomationProperties.Name="Esfuerzo"
                                                  ToolTipService.ToolTip="Esfuerzo" SelectionChanged="EffortBox_SelectionChanged" />
                                        <ComboBox x:Name="ModeBox" MinWidth="120" AutomationProperties.Name="Modo de permisos"
                                                  ToolTipService.ToolTip="Modo de permisos" SelectionChanged="ModeBox_SelectionChanged" />
                                    </StackPanel>
                                    <Button x:Name="SendButton" Grid.Column="2" Click="Send_Click" Width="30" Height="30" Padding="0"
                                            CornerRadius="15" Style="{ThemeResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Enviar" AutomationProperties.Name="Enviar">
                                        <FontIcon x:Name="SendGlyph" Glyph="&#xE74A;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Hoja "Nuevo agente": sustituye al ContentDialog y al selector de carpetas de WinRT (que falla elevado). -->
        <Grid x:Name="NewAgentSheet" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{ThemeResource JackScrimBrush}" Tapped="SheetScrim_Tapped">
            <Border Width="480" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12"
                    BorderThickness="1" Padding="22" Tapped="SheetCard_Tapped"
                    Background="{ThemeResource JackChromeBrush}" BorderBrush="{ThemeResource JackHairlineBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Nuevo agente" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Carpeta del proyecto" FontSize="12" Style="{StaticResource JackCaption}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SheetFolder" PlaceholderText="C:\ruta\al\proyecto" TextChanged="SheetFolder_TextChanged"
                                     AutomationProperties.Name="Carpeta del proyecto" />
                            <Button Grid.Column="1" Content="Examinar…" Click="SheetBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="SheetHint" FontSize="11.5" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="SheetRecentBox" Spacing="4">
                        <TextBlock Text="Recientes" FontSize="12" Style="{StaticResource JackCaption}" />
                        <StackPanel x:Name="SheetRecent" Spacing="1" />
                    </StackPanel>
                    <TextBox x:Name="SheetName" Header="Nombre (opcional)" MaxLength="120" PlaceholderText="Por defecto, el que genera el agente" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Proveedor" FontSize="12" Style="{StaticResource JackCaption}" />
                        <RadioButton Content="Claude Code" IsChecked="True" GroupName="Prov" />
                        <TextBlock Text="Codex, OpenCode y otros llegarán más adelante a Windows." FontSize="11.5" Style="{StaticResource JackCaption}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Cancelar" Click="SheetCancel_Click" Padding="16,6" />
                        <Button x:Name="SheetCreate" Content="Crear agente" Click="SheetCreate_Click" IsEnabled="False"
                                Style="{ThemeResource AccentButtonStyle}" Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
