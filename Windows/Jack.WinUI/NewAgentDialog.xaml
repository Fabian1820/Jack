<ContentDialog
    x:Class="Jack.WinUI.NewAgentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nuevo agente"
    PrimaryButtonText="Crear agente"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">
    <StackPanel Width="440" Spacing="16">
        <TextBlock Text="Carpeta del proyecto" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" IsReadOnly="True" PlaceholderText="Ninguna carpeta seleccionada"
                     AutomationProperties.Name="Carpeta del proyecto" />
            <Button Grid.Column="1" Content="Examinar…" Click="Browse_Click" />
        </Grid>

        <TextBox x:Name="NameBox" Header="Nombre (opcional)" MaxLength="120"
                 PlaceholderText="Si lo dejas vacío, el agente usa su nombre por defecto" />

        <TextBlock Text="Proveedor" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <StackPanel Spacing="8">
            <RadioButton GroupName="Provider" Content="Claude Code" IsChecked="True" />
            <RadioButton GroupName="Provider" IsEnabled="False" Content="Codex · Próximamente en Windows" />
            <RadioButton GroupName="Provider" IsEnabled="False" Content="OpenCode · Próximamente en Windows" />
            <RadioButton GroupName="Provider" IsEnabled="False" Content="Stellar Code · Próximamente en Windows" />
            <RadioButton GroupName="Provider" IsEnabled="False" Content="Antigravity · Próximamente en Windows" />
            <RadioButton GroupName="Provider" IsEnabled="False" Content="Qoder · Próximamente en Windows" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
